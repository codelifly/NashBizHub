# NashBizHub environment template
# Copy to .env.local for local demo work.

# demo | staging | production
APP_ENV=demo

# Must be false in production (startup refuses otherwise)
DEMO_MODE=true

# Keep false in demo; enable only when ready for public indexing
INDEXING_ENABLED=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate a long random secret for any shared environment
# Use at least 32 characters in any shared environment
BETTER_AUTH_SECRET=demo-local-dev-secret-replace-me-32chars

# SQLite file for local demo (not for serverless durability)
DATABASE_URL=file:./storage/demo.sqlite

# Private uploads / document room files (local path)
PRIVATE_STORAGE_PATH=./storage/private

# Adapters — demo only in this repository
EMAIL_ADAPTER=demo-outbox
SIGNING_ADAPTER=demo
BILLING_ADAPTER=demo

# none | leaflet | maplibre
MAP_PROVIDER=none
